{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotionProfile",
  "type": "object",
  "required": [
    "schema_version",
    "motion_profile_id",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "motion_profile_id": {
      "type": "string"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "interaction_type",
          "required_anchors",
          "role_a_motion",
          "role_b_motion"
        ],
        "properties": {
          "interaction_type": {
            "type": "string"
          },
          "required_anchors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role_a_motion": {
            "type": "string"
          },
          "role_b_motion": {
            "type": "string"
          },
          "fallback_to_ground": {
            "type": "boolean"
          },
          "contact_anchor": {
            "type": "string"
          },
          "approach_anchor": {
            "type": "string"
          },
          "role_a_forearm_contact_lift_m": {
            "description": "Optional wrist lift for furniture contact, in metres, with forearm length and hand orientation preserved.",
            "type": "number",
            "minimum": 0
          },
          "role_b_seated_foot_offset": {
            "description": "Optional actor-local foot offset after seat placement, in metres, preserving leg lengths and foot orientation.",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          },
          "role_a_seated_skirt_support": {
            "description": "Optional furniture support for named cloth bones. Half extents and bone clearance above the surface are in metres.",
            "type": "object",
            "required": ["bone_prefix", "half_extents"],
            "properties": {
              "bone_prefix": {"type": "string"},
              "half_extents": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}},
              "bone_clearance_m": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          },
          "role_b_seated_skirt_support": {
            "description": "Optional seat support for named cloth bones; half_extents are in anchor-local X and Z metres.",
            "type": "object",
            "required": ["bone_prefix", "half_extents"],
            "properties": {
              "bone_prefix": {"type": "string"},
              "half_extents": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}},
              "bone_clearance_m": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          },
          "role_a_placement": {
            "type": "object",
            "required": [
              "offset",
              "yaw_degrees"
            ],
            "properties": {
              "offset": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "yaw_degrees": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "role_b_placement": {
            "type": "object",
            "required": [
              "offset",
              "yaw_degrees"
            ],
            "properties": {
              "offset": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "yaw_degrees": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
