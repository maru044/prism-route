{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpawnDefinition",
  "type": "object",
  "required": ["schema_version", "spawn_id", "character_id", "region", "position", "heading"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "spawn_id": { "type": "string" },
    "character_id": { "type": "string" },
    "region": { "type": "string" },
    "position": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "heading": { "type": "number" },
    "bound_furniture": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "anchor"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "anchor": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
