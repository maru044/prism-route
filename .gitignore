# Godot 4+ specific ignores
.godot/
/android/
# Temporary render diagnostics; keep the two curated scene captures tracked.
/screenshots/vegetation_test_wind_later.png*
/screenshots/wind_field_open_simplex2s.png*
# Regenerable vegetation-HLOD build cache and Blender safety copies.
/.tree_hlod_build/
/.vegetation_art_build/
/assets/vegetation/source/*.blend1
/assets/products/**/source/*.blend1
# Godot may extract GLB-embedded HLOD textures next to the model during import;
# the authored copies live under assets/vegetation/textures.
/assets/vegetation/models/*_lod*_*.png*
# Godot may leave a locked temporary copy while a GDExtension DLL is loaded.
/addons/vrm/bin/~*.TMP
